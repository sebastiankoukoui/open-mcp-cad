<!--
Open MCP CAD - das Einrichtungsfenster (seit 2026-10-09, Rueckmeldung: das
schwarze Fenster des Installers schreckte ab). Geladen von
install_fenster.ps1 (WPF, Windows PowerShell 5.1). Alle Texte, die man
sieht, stehen HIER (UTF-8; install_fenster.ps1 selbst bleibt ASCII, weil
PowerShell 5.1 Skripte ohne BOM als ANSI liest) - die festen in den
Seiten, die zusammengesetzten als Ressourcen "t_..." unten. Jede Seite ist
ein Grid "Seite_<name>", gezeigt wird immer genau eine.

Farben aus dem Logo: Violett #5B3CC4, hell #EEEAFB. Schrift Segoe UI.
Keine Emoji, keine Pfade ausser in "Details" und auf der Fehlerseite.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Open MCP CAD einrichten"
        SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F7F6FB">
  <!-- Alles haengt an "Wurzel" (auch Schrift und Ressourcen): so laesst sie
       sich ohne Fenster rendern (install_fenster.ps1 -Rendern). -->
  <Border x:Name="Wurzel" Width="640" Height="480" Background="#F7F6FB"
          TextElement.FontFamily="Segoe UI" TextElement.FontSize="14"
          UseLayoutRounding="True" SnapsToDevicePixels="True"
          TextOptions.TextFormattingMode="Ideal">
  <Border.Resources>
    <SolidColorBrush x:Key="Violett" Color="#5B3CC4"/>
    <SolidColorBrush x:Key="ViolettDunkel" Color="#4A2FA6"/>
    <SolidColorBrush x:Key="ViolettHell" Color="#EEEAFB"/>
    <SolidColorBrush x:Key="Text" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Neben" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Rahmen" Color="#E4E1EE"/>
    <SolidColorBrush x:Key="Karte" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Orange" Color="#C26A00"/>
    <SolidColorBrush x:Key="OrangeHell" Color="#FFF5E6"/>
    <SolidColorBrush x:Key="Rot" Color="#D2302C"/>
    <SolidColorBrush x:Key="RotHell" Color="#FDEEEE"/>

    <!-- Die zusammengesetzten Texte (install_fenster.ps1 holt sie per Schluessel). -->
    <sys:String x:Key="t_suche">Ich schaue nach, was schon da ist …</sys:String>
    <sys:String x:Key="t_bereit_zum_start">Alles bereit. Es kann losgehen.</sys:String>
    <sys:String x:Key="t_gefunden">Gefunden</sys:String>
    <sys:String x:Key="t_profil_empfohlen">empfohlen</sys:String>
    <sys:String x:Key="t_profil_installiert">installiert</sys:String>
    <sys:String x:Key="t_profil_nicht_installiert">Programm nicht gefunden</sys:String>
    <sys:String x:Key="t_trenner" xml:space="preserve"> · </sys:String>
    <sys:String x:Key="t_profil_name">Cadwork {0}</sys:String>
    <sys:String x:Key="t_profil_unbekannt">Unbekannte Cadwork-Version</sys:String>
    <sys:String x:Key="t_python_winget">Es kommt über den Paketmanager von Windows.</sys:String>
    <sys:String x:Key="t_python_org">Es kommt direkt von python.org (rund 30 MB). Vorher prüfe ich die digitale Unterschrift.</sys:String>
    <sys:String x:Key="t_bereit_plugin">Open MCP CAD in Cadwork {0}</sys:String>
    <sys:String x:Key="t_bereit_plugin_trotzdem">Open MCP CAD in Cadwork {0} (passt nicht, auf deinen Wunsch)</sys:String>
    <sys:String x:Key="t_bereit_ki">Verbindung für {0}</sys:String>
    <sys:String x:Key="t_bereit_keine_ki">Keine KI-App. Du kannst sie später nachtragen.</sys:String>
    <sys:String x:Key="t_bereit_python">Python wird mitinstalliert</sys:String>
    <sys:String x:Key="t_und">und</sys:String>
    <sys:String x:Key="t_fertig_mit">Verbunden mit {0}.</sys:String>
    <sys:String x:Key="t_fertig_ohne">Noch mit keiner KI-App verbunden. Installiere eine und starte die Einrichtung nochmals.</sys:String>
    <sys:String x:Key="t_fertig_teilweise">In {0} ging das Eintragen nicht, siehe Details.</sys:String>
    <sys:String x:Key="t_name_codex">ChatGPT-App</sys:String>
    <sys:String x:Key="t_name_claude_desktop">Claude Desktop</sys:String>
    <sys:String x:Key="t_name_claude_code">Claude Code</sys:String>
    <sys:String x:Key="t_fehler_unerwartet">Die Einrichtung wurde unerwartet beendet.</sys:String>
    <sys:String x:Key="t_fehler_profil">Ich habe kein Cadwork gefunden. Ist Cadwork 3D 2026 auf diesem PC installiert?</sys:String>
    <sys:String x:Key="t_fehler_plugin">Open MCP CAD liess sich nicht in Cadwork einrichten.</sys:String>
    <sys:String x:Key="t_fehler_version">Open MCP CAD liegt jetzt in Cadwork, passt aber nicht zu dieser Cadwork-Version. Dort startet es nicht.</sys:String>
    <sys:String x:Key="t_fehler_python">Python fehlt noch, und ich konnte es nicht installieren. Ist der PC mit dem Internet verbunden?</sys:String>
    <sys:String x:Key="t_fehler_server">Der Teil für die KI-App liess sich nicht einrichten. Meist fehlt kurz die Internetverbindung. Versuche es einfach nochmals.</sys:String>
    <sys:String x:Key="t_kopiert">Kopiert.</sys:String>
    <!-- Seit 2026-10-09 (Rueckmeldung): Chat in Cadwork, Unterzeile, KI hilft. -->
    <sys:String x:Key="t_ki_hilfe">Hilf mir bitte, Open MCP CAD einzurichten. Es verbindet Cadwork 3D 2026 mit einer KI. Führe mich Schritt für Schritt, immer nur einen Schritt, und warte, bis ich ihn erledigt habe. 1) Die neueste ZIP-Datei herunterladen: https://github.com/sebastiankoukoui/open-mcp-cad/releases/latest 2) Cadwork schliessen und die ZIP-Datei entpacken (rechte Maustaste, «Alle extrahieren»). 3) Im entpackten Ordner 1_INSTALLIEREN.cmd doppelklicken und im Einrichtungsfenster «Installieren» klicken. Das ist der empfohlene Weg. 4) Danach die KI-App ganz beenden und neu starten. 5) In Cadwork auf «Open MCP CAD» klicken, bis «Bereit» steht. Klappt etwas nicht, lies die Datei Programmdateien\FUER_KI_ASSISTENTEN.md im entpackten Ordner. Bau keinen eigenen Adapter und sprich nicht selbst mit dem Port des Plugins, alles ist schon da.</sys:String>
    <sys:String x:Key="t_schon_da">Schon da</sys:String>
    <sys:String x:Key="t_chat_name_claude">Claude</sys:String>
    <sys:String x:Key="t_chat_name_codex">ChatGPT (Codex)</sys:String>
    <sys:String x:Key="t_bereit_chat">{0} für den Chat in Cadwork (wird installiert, danach meldest du dich an)</sys:String>
    <sys:String x:Key="t_bereit_chat_da">{0} für den Chat in Cadwork (schon da)</sys:String>
    <sys:String x:Key="t_bereit_chat_spaeter">Chat in Cadwork: die KI wählst du später im Chat</sys:String>
    <sys:String x:Key="t_unter_python_laden">Python wird heruntergeladen (rund 30 MB) …</sys:String>
    <sys:String x:Key="t_unter_python_installieren">Python wird installiert …</sys:String>
    <sys:String x:Key="t_unter_pip_laden">Zusatzteile werden geladen: {0} …</sys:String>
    <sys:String x:Key="t_unter_pip_installieren">Zusatzteile werden installiert …</sys:String>
    <sys:String x:Key="t_unter_cli_laden">{0} wird heruntergeladen und installiert …</sys:String>
    <sys:String x:Key="t_unter_pruefen">Ich prüfe, ob alles läuft …</sys:String>
    <sys:String x:Key="t_anmelden_titel">Bei {0} anmelden</sys:String>
    <sys:String x:Key="t_anmelden_warte">Warte auf die Anmeldung im Browser …</sys:String>
    <sys:String x:Key="t_anmelden_nicht">Die Anmeldung ist noch nicht abgeschlossen. Versuche es nochmals.</sys:String>
    <sys:String x:Key="t_fertig_app_1">Deine KI-App ganz beenden und neu starten.</sys:String>
    <sys:String x:Key="t_fertig_app_2">In Cadwork auf «Open MCP CAD» klicken, bis «Bereit» steht.</sys:String>
    <sys:String x:Key="t_fertig_app_3">In der App einfach schreiben, was du in Cadwork brauchst.</sys:String>
    <sys:String x:Key="t_fertig_chat_1">In Cadwork auf «Open MCP CAD» klicken, bis «Bereit» steht.</sys:String>
    <sys:String x:Key="t_fertig_chat_2">In der Leiste auf die Sprechblase klicken. Der Chat öffnet sich.</sys:String>
    <sys:String x:Key="t_fertig_chat_3">Schreib, was du brauchst. Vor jeder Änderung fragt dich die KI.</sys:String>
    <sys:String x:Key="t_fertig_beides_4">Oder direkt in Cadwork: in der Leiste auf die Sprechblase klicken.</sys:String>
    <sys:String x:Key="t_fertig_spaeter_4">Im Chat unter «⋯» die Einstellungen öffnen und deine KI wählen.</sys:String>
    <sys:String x:Key="t_fertig_anmelden_4">Anmelden kannst du später: 1_INSTALLIEREN.cmd nochmals starten.</sys:String>
    <sys:String x:Key="t_fertig_chat_ki">Der Chat in Cadwork arbeitet mit {0}.</sys:String>
    <sys:String x:Key="t_fehler_chat">Die KI für den Chat in Cadwork liess sich nicht einrichten. Ist der PC mit dem Internet verbunden?</sys:String>
    <sys:String x:Key="t_schritt_laeuft">läuft …</sys:String>

    <!-- Hauptknopf: violett, gefuellt. -->
    <Style x:Key="Haupt" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Violett}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="132"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource ViolettDunkel}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource ViolettDunkel}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#CFC6F0"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Zweitknopf: weiss mit Rahmen. -->
    <Style x:Key="Zweit" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="110"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="#D6D2E3" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F2F0F8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#B0B0B5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Verweis: nur Text, violett. -->
    <Style x:Key="Verweis" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Violett}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="2,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Ankreuzen: grosses, rundes Kaestchen. -->
    <Style x:Key="Haken" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="k" Width="22" Height="22" CornerRadius="6" BorderThickness="1.5" BorderBrush="#BDB6D6" Background="White" VerticalAlignment="Center">
                <Path x:Name="h" Data="M 5,11 L 9,15 L 17,7" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="k" Property="Background" Value="{StaticResource Violett}"/>
                <Setter TargetName="k" Property="BorderBrush" Value="{StaticResource Violett}"/>
                <Setter TargetName="h" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="k" Property="Background" Value="#F0EFF4"/>
                <Setter TargetName="k" Property="BorderBrush" Value="#DAD7E4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Wahl" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="r" Background="White" BorderBrush="{StaticResource Rahmen}" BorderThickness="1.5" CornerRadius="10" Padding="16,12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="o" Width="20" Height="20" Stroke="#BDB6D6" StrokeThickness="1.5" Fill="White" VerticalAlignment="Center"/>
                <Ellipse x:Name="i" Width="10" Height="10" Fill="White" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="r" Property="BorderBrush" Value="{StaticResource Violett}"/>
                <Setter TargetName="o" Property="Fill" Value="{StaticResource Violett}"/>
                <Setter TargetName="o" Property="Stroke" Value="{StaticResource Violett}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Titel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Satz" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Neben}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style x:Key="KarteRahmen" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Karte}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rahmen}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18,14"/>
    </Style>
    <Style x:Key="Marke" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource ViolettHell}"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Leiste" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4" Background="#E7E3F4"/>
              <Border x:Name="PART_Indicator" CornerRadius="4" Background="{StaticResource Violett}" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Ein Schritt im Fortschritt: Kreis (offen / laeuft / fertig / fehler) und Text. -->
    <Style x:Key="SchrittText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Neben}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="14,0,0,0"/>
    </Style>
    <Style x:Key="Protokoll" TargetType="TextBox">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Background" Value="#FBFBFD"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rahmen}"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
  </Border.Resources>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Kopf -->
      <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Rahmen}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
          <Image x:Name="KopfLogo" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Open MCP CAD" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
          <TextBlock Text="Einrichtung" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Neben}"/>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1" Margin="40,26,40,26">

        <!-- 1 Willkommen -->
        <DockPanel x:Name="Seite_willkommen">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="willkommen_weiter" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Los geht’s" IsEnabled="False"/>
            <TextBlock x:Name="willkommen_stand" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource Neben}" FontSize="13"/>
          </DockPanel>
          <StackPanel VerticalAlignment="Center" Margin="0,0,0,10">
            <Border Width="60" Height="60" CornerRadius="14" Background="White" BorderBrush="{StaticResource Rahmen}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12">
              <Image x:Name="willkommen_logo" Width="50" Height="50" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Style="{StaticResource Titel}" Text="Willkommen bei Open MCP CAD"/>
            <TextBlock Style="{StaticResource Satz}" FontSize="15" Text="Damit zeichnet eine KI für dich in Cadwork. Ich richte alles ein. Das dauert ein paar Minuten und braucht Internet."/>
            <Border x:Name="willkommen_hinweis" Style="{StaticResource KarteRahmen}" Margin="0,16,0,0">
              <StackPanel Orientation="Horizontal">
                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource ViolettHell}" VerticalAlignment="Top">
                  <TextBlock Text="i" FontWeight="Bold" Foreground="{StaticResource Violett}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Margin="12,3,0,0" TextWrapping="Wrap" Width="470" Foreground="{StaticResource Text}" Text="Schliesse Cadwork, bevor du beginnst."/>
              </StackPanel>
            </Border>
            <Border x:Name="willkommen_ki_hilfe" Style="{StaticResource KarteRahmen}" Margin="0,10,0,0" Background="{StaticResource ViolettHell}" BorderThickness="0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Button x:Name="willkommen_kopieren" Style="{StaticResource Verweis}" Content="Text kopieren"/>
                  <TextBlock x:Name="willkommen_kopiert" FontSize="12" Foreground="{StaticResource Neben}" HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Text}" Text="Du nutzt schon eine KI-App am PC? Kopiere diesen Text und schick ihn ihr, sie hilft dir beim Einrichten."/>
              </DockPanel>
            </Border>
          </StackPanel>
        </DockPanel>

        <!-- 1b Wo arbeiten? (seit 2026-10-09) -->
        <DockPanel x:Name="Seite_wo" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="wo_weiter" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Weiter"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="Wo möchtest du mit der KI arbeiten?"/>
            <TextBlock Style="{StaticResource Satz}" Margin="0,0,0,14" Text="Du kannst später jederzeit wechseln."/>
            <RadioButton x:Name="wo_app" Style="{StaticResource Wahl}" GroupName="wo">
              <StackPanel>
                <TextBlock Text="In deiner KI-App" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" TextWrapping="Wrap" Text="Claude Desktop oder die ChatGPT-App. Die gewohnte Oberfläche, die KI zeichnet in Cadwork."/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="wo_chat" Style="{StaticResource Wahl}" GroupName="wo">
              <StackPanel>
                <TextBlock Text="Direkt in Cadwork im Chat" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" TextWrapping="Wrap" Text="Der Chat steht neben der Zeichnung. Du bestimmst, was die KI allein darf."/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="wo_beides" Style="{StaticResource Wahl}" GroupName="wo">
              <StackPanel>
                <TextBlock Text="Beides" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" TextWrapping="Wrap" Text="Die App für den Alltag, der Chat in Cadwork zum Ausprobieren."/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </DockPanel>

        <!-- 2c Welche KI im Chat in Cadwork? (seit 2026-10-09) -->
        <DockPanel x:Name="Seite_chat_ki" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="chat_weiter" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Weiter"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="Welche KI im Chat in Cadwork?"/>
            <TextBlock Style="{StaticResource Satz}" Margin="0,0,0,14" Text="Der Chat braucht ein kleines Programm des Anbieters. Ich installiere es mit, und du meldest dich einmal an."/>
            <RadioButton x:Name="chat_claude" Style="{StaticResource Wahl}" GroupName="chat">
              <DockPanel>
                <Border x:Name="chat_marke_claude" DockPanel.Dock="Right" Style="{StaticResource Marke}">
                  <TextBlock x:Name="chat_stand_claude" FontSize="12.5" Foreground="{StaticResource Violett}" FontWeight="SemiBold"/>
                </Border>
                <StackPanel>
                  <TextBlock Text="Claude" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                  <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" Text="mit einem Claude-Abo (Pro oder Max)"/>
                </StackPanel>
              </DockPanel>
            </RadioButton>
            <RadioButton x:Name="chat_codex" Style="{StaticResource Wahl}" GroupName="chat">
              <DockPanel>
                <Border x:Name="chat_marke_codex" DockPanel.Dock="Right" Style="{StaticResource Marke}">
                  <TextBlock x:Name="chat_stand_codex" FontSize="12.5" Foreground="{StaticResource Violett}" FontWeight="SemiBold"/>
                </Border>
                <StackPanel>
                  <TextBlock Text="ChatGPT (Codex)" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                  <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" Text="mit einem ChatGPT-Abo (Plus oder Pro)"/>
                </StackPanel>
              </DockPanel>
            </RadioButton>
            <RadioButton x:Name="chat_spaeter" Style="{StaticResource Wahl}" GroupName="chat">
              <StackPanel>
                <TextBlock Text="Später oder mit eigenem Schlüssel" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" TextWrapping="Wrap" Text="Im Chat unter Einstellungen: Schlüssel eingeben oder eine KI auf deinem PC wählen."/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </DockPanel>

        <!-- 2 Deine KI-App -->
        <DockPanel x:Name="Seite_ki" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="ki_weiter" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Weiter"/>
            <Button x:Name="ki_nochmal" DockPanel.Dock="Left" Style="{StaticResource Verweis}" Content="Nochmal suchen" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="Deine KI-App"/>
            <TextBlock Style="{StaticResource Satz}" Text="In welcher App möchtest du mit Cadwork arbeiten? Was ich gefunden habe, ist schon angehakt."/>
            <StackPanel Margin="0,16,0,0">
              <Border x:Name="ki_karte_claude_desktop" Style="{StaticResource KarteRahmen}" Margin="0,0,0,10">
                <DockPanel>
                  <Button x:Name="ki_holen_claude_desktop" DockPanel.Dock="Right" Style="{StaticResource Verweis}" Content="Herunterladen" VerticalAlignment="Center"/>
                  <Border x:Name="ki_marke_claude_desktop" DockPanel.Dock="Right" Style="{StaticResource Marke}">
                    <TextBlock x:Name="ki_stand_claude_desktop" FontSize="12.5" Foreground="{StaticResource Violett}" FontWeight="SemiBold"/>
                  </Border>
                  <CheckBox x:Name="ki_claude_desktop" Style="{StaticResource Haken}">
                    <StackPanel>
                      <TextBlock Text="Claude Desktop" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                      <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" Text="für ein Claude-Abo"/>
                    </StackPanel>
                  </CheckBox>
                </DockPanel>
              </Border>
              <Border x:Name="ki_karte_codex" Style="{StaticResource KarteRahmen}" Margin="0,0,0,10">
                <DockPanel>
                  <Button x:Name="ki_holen_codex" DockPanel.Dock="Right" Style="{StaticResource Verweis}" Content="Herunterladen" VerticalAlignment="Center"/>
                  <Border x:Name="ki_marke_codex" DockPanel.Dock="Right" Style="{StaticResource Marke}">
                    <TextBlock x:Name="ki_stand_codex" FontSize="12.5" Foreground="{StaticResource Violett}" FontWeight="SemiBold"/>
                  </Border>
                  <CheckBox x:Name="ki_codex" Style="{StaticResource Haken}">
                    <StackPanel>
                      <TextBlock Text="ChatGPT-App (mit Codex)" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                      <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" Text="für ein ChatGPT-Abo, die Desktop-App am PC"/>
                    </StackPanel>
                  </CheckBox>
                </DockPanel>
              </Border>
              <Border x:Name="ki_karte_claude_code" Style="{StaticResource KarteRahmen}" Margin="0,0,0,10">
                <DockPanel>
                  <Border x:Name="ki_marke_claude_code" DockPanel.Dock="Right" Style="{StaticResource Marke}">
                    <TextBlock x:Name="ki_stand_claude_code" FontSize="12.5" Foreground="{StaticResource Violett}" FontWeight="SemiBold"/>
                  </Border>
                  <CheckBox x:Name="ki_claude_code" Style="{StaticResource Haken}">
                    <StackPanel>
                      <TextBlock Text="Claude Code" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                      <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" Text="Claude im Befehlsfenster"/>
                    </StackPanel>
                  </CheckBox>
                </DockPanel>
              </Border>
            </StackPanel>
            <TextBlock x:Name="ki_chatgpt" Style="{StaticResource Satz}" FontSize="12.5" Margin="2,4,0,0" Text="Es geht nur mit der App am PC, nicht im Browser oder am Handy."/>
          </StackPanel>
        </DockPanel>

        <!-- 2b Keine KI-App gefunden -->
        <DockPanel x:Name="Seite_ki_keine" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="keine_nochmal" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Nochmal suchen"/>
            <Button x:Name="keine_ohne" DockPanel.Dock="Left" Style="{StaticResource Verweis}" Content="Ohne KI-App weiter" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="Du brauchst zuerst eine KI-App"/>
            <TextBlock Style="{StaticResource Satz}" Text="Open MCP CAD verbindet Cadwork mit einer KI-App auf diesem PC. Installiere eine davon, melde dich an und klicke dann auf «Nochmal suchen»."/>
            <UniformGrid Columns="2" Margin="0,18,0,0">
              <Button x:Name="keine_claude" Margin="0,0,8,0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Style="{StaticResource KarteRahmen}" Padding="18,16">
                      <StackPanel>
                        <TextBlock Text="Claude Desktop holen" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Violett}"/>
                        <TextBlock Text="für ein Claude-Abo" Foreground="{StaticResource Neben}" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Violett}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button x:Name="keine_codex" Margin="8,0,0,0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Style="{StaticResource KarteRahmen}" Padding="18,16">
                      <StackPanel>
                        <TextBlock Text="ChatGPT-App holen" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Violett}"/>
                        <TextBlock Text="für ein ChatGPT-Abo" Foreground="{StaticResource Neben}" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Violett}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </UniformGrid>
            <Border Style="{StaticResource KarteRahmen}" Margin="0,14,0,0" Background="{StaticResource ViolettHell}" BorderThickness="0">
              <TextBlock x:Name="keine_chatgpt" TextWrapping="Wrap" Foreground="{StaticResource Text}" Text="Es geht nur mit der App am PC, nicht im Browser oder am Handy."/>
            </Border>
          </StackPanel>
        </DockPanel>

        <!-- 3a Welches Cadwork? (nur bei mehreren Profilen) -->
        <DockPanel x:Name="Seite_profil" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="profil_weiter" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Weiter"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="Welches Cadwork?"/>
            <TextBlock Style="{StaticResource Satz}" Text="Auf diesem PC gibt es mehrere Cadwork-Versionen. Open MCP CAD läuft in Cadwork 3D 2026."/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230" Margin="0,16,0,0">
              <StackPanel x:Name="profil_liste"/>
            </ScrollViewer>
          </StackPanel>
        </DockPanel>

        <!-- 3b Cadwork-Version passt nicht -->
        <DockPanel x:Name="Seite_version" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="version_schliessen" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Schliessen"/>
            <Button x:Name="version_zurueck" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="Zurück" Margin="0,0,10,0"/>
            <Button x:Name="version_trotzdem" DockPanel.Dock="Left" Style="{StaticResource Verweis}" Content="Trotzdem installieren" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel>
            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource OrangeHell}" HorizontalAlignment="Left" Margin="0,0,0,16">
              <TextBlock Text="!" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Orange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource Titel}" Text="Das passt nicht zu deinem Cadwork"/>
            <TextBlock x:Name="version_text" Style="{StaticResource Satz}" Foreground="{StaticResource Text}"/>
            <TextBlock Style="{StaticResource Satz}" Margin="0,10,0,0" Text="Dort startet Open MCP CAD nicht. Installiere zuerst Cadwork 3D 2026. Oder installiere trotzdem, wenn du genau weisst, was du tust."/>
          </StackPanel>
        </DockPanel>

        <!-- 3c Python fehlt -->
        <DockPanel x:Name="Seite_python" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="python_ja" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Mitinstallieren"/>
            <Button x:Name="python_nein" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="Abbrechen" Margin="0,0,10,0"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="Ein Programmteil fehlt noch"/>
            <TextBlock Style="{StaticResource Satz}" Text="Open MCP CAD braucht Python, eine kostenlose Programmiersprache. Ich installiere es mit, nur für dein Benutzerkonto und ohne Administratorrechte."/>
            <Border Style="{StaticResource KarteRahmen}" Margin="0,18,0,0">
              <TextBlock x:Name="python_weg" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
            </Border>
          </StackPanel>
        </DockPanel>

        <!-- 4 Bereit -->
        <DockPanel x:Name="Seite_bereit" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="bereit_installieren" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Installieren"/>
            <Button x:Name="bereit_zurueck" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="Zurück" Margin="0,0,10,0"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="Bereit zum Installieren"/>
            <TextBlock Style="{StaticResource Satz}" Text="Das richte ich jetzt ein:"/>
            <Border Style="{StaticResource KarteRahmen}" Margin="0,16,0,0">
              <StackPanel x:Name="bereit_liste"/>
            </Border>
            <TextBlock Style="{StaticResource Satz}" Margin="0,14,0,0" FontSize="12.5" Text="Vorher sichere ich die Einstellungen deiner KI-App. Andere Einträge bleiben, wie sie sind."/>
          </StackPanel>
        </DockPanel>

        <!-- 5 Es laeuft -->
        <DockPanel x:Name="Seite_laeuft" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <ToggleButton x:Name="laeuft_details" DockPanel.Dock="Left" Content="Details anzeigen" Cursor="Hand" VerticalAlignment="Center">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource Violett}" Padding="2,6"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Neben}" FontSize="12.5" Text="Das dauert ein paar Minuten."/>
          </DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Titel}" Text="Wird eingerichtet …"/>
            <ProgressBar x:Name="laeuft_leiste" Style="{StaticResource Leiste}" Minimum="0" Maximum="100" Value="0" Margin="0,6,0,4"/>
            <!-- Bewegtes Band: es arbeitet, auch wenn eine Zeile lange gleich bleibt. -->
            <Border x:Name="laeuft_band" Height="3" CornerRadius="1.5" Background="#E7E3F4" ClipToBounds="True" Visibility="Hidden">
              <Rectangle x:Name="laeuft_band_lauf" Width="140" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#005B3CC4" Offset="0"/>
                    <GradientStop Color="#FF5B3CC4" Offset="0.5"/>
                    <GradientStop Color="#005B3CC4" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                  <TranslateTransform x:Name="laeuft_band_weg" X="180"/>
                </Rectangle.RenderTransform>
              </Rectangle>
            </Border>
            <TextBlock x:Name="laeuft_unterzeile" FontSize="12.5" Foreground="{StaticResource Neben}" Margin="0,6,0,12" TextTrimming="CharacterEllipsis" Text=" "/>
          </StackPanel>
          <Grid>
            <StackPanel x:Name="laeuft_schritte">
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s1_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s1_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s1_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="Cadwork prüfen"/>
              </Grid>
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s2_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s2_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s2_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="Open MCP CAD in Cadwork einrichten"/>
              </Grid>
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s3_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s3_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s3_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="Verbindung für die KI-App einrichten"/>
              </Grid>
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s4_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s4_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s4_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="Einstellungen speichern"/>
              </Grid>
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s5_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s5_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s5_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="KI-App verbinden"/>
              </Grid>
              <Grid x:Name="s6_zeile" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s6_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s6_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s6_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="KI für den Chat in Cadwork einrichten"/>
              </Grid>
            </StackPanel>
            <TextBox x:Name="laeuft_protokoll" Style="{StaticResource Protokoll}" Visibility="Collapsed" Margin="0,0,0,12"/>
          </Grid>
        </DockPanel>

        <!-- 5b Anmelden (seit 2026-10-09) -->
        <DockPanel x:Name="Seite_anmelden" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="anmelden_los" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Anmelden"/>
            <Button x:Name="anmelden_spaeter" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="Später" Margin="0,0,10,0"/>
          </DockPanel>
          <StackPanel>
            <TextBlock x:Name="anmelden_titel" Style="{StaticResource Titel}" Text="Bei Claude anmelden"/>
            <TextBlock Style="{StaticResource Satz}" Text="Damit der Chat in Cadwork mit deinem Abo arbeitet, meldest du dich einmal an."/>
            <Border x:Name="anmelden_karte" Style="{StaticResource KarteRahmen}" Margin="0,16,0,0">
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text}" LineHeight="21" Text="Nach «Anmelden» öffnet sich ein kleines schwarzes Fenster und dein Browser. Melde dich im Browser an. Danach schliesst sich das kleine Fenster von selbst."/>
            </Border>
            <TextBlock x:Name="anmelden_stand" Style="{StaticResource Satz}" Margin="2,12,0,0"/>
          </StackPanel>
        </DockPanel>

        <!-- 6 Fertig -->
        <DockPanel x:Name="Seite_fertig" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="fertig_schliessen" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Schliessen"/>
            <Button x:Name="fertig_anleitung" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="Anleitung öffnen" Margin="0,0,10,0"/>
            <ToggleButton x:Name="fertig_details" DockPanel.Dock="Left" Content="Details" Cursor="Hand" VerticalAlignment="Center">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource Violett}" Padding="2,6"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
          </DockPanel>
          <Grid>
            <StackPanel x:Name="fertig_inhalt">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Violett}" VerticalAlignment="Center">
                  <Path Data="M 12,22 L 19,29 L 32,15" Stroke="White" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
                <TextBlock x:Name="fertig_titel" Style="{StaticResource Titel}" Text="Fertig eingerichtet" Margin="16,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="fertig_ki" Style="{StaticResource Satz}" Margin="0,4,0,14"/>
              <Border x:Name="fertig_schritte" Style="{StaticResource KarteRahmen}">
                <StackPanel>
                  <TextBlock Text="So geht es weiter:" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,8"/>
                  <Grid x:Name="fertig_schritt1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ViolettHell}" VerticalAlignment="Top"><TextBlock Text="1" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Violett}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock x:Name="fertig_text1" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Text}" Text="Deine KI-App ganz beenden und neu starten."/>
                  </Grid>
                  <Grid x:Name="fertig_schritt2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ViolettHell}" VerticalAlignment="Top"><TextBlock Text="2" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Violett}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock x:Name="fertig_text2" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Text}" Text="In Cadwork auf «Open MCP CAD» klicken, bis «Bereit» steht."/>
                  </Grid>
                  <Grid x:Name="fertig_schritt3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ViolettHell}" VerticalAlignment="Top"><TextBlock Text="3" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Violett}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock x:Name="fertig_text3" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Text}" Text="In der App einfach schreiben, was du in Cadwork brauchst."/>
                  </Grid>
                  <Grid x:Name="fertig_schritt4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ViolettHell}" VerticalAlignment="Top"><TextBlock Text="4" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Violett}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock x:Name="fertig_text4" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBox x:Name="fertig_protokoll" Style="{StaticResource Protokoll}" Visibility="Collapsed" Margin="0,0,0,12"/>
          </Grid>
        </DockPanel>

        <!-- 7 Fehler -->
        <DockPanel x:Name="Seite_fehler" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="fehler_schliessen" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="Schliessen"/>
            <Button x:Name="fehler_kopieren" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="Details kopieren" Margin="0,0,10,0"/>
            <ToggleButton x:Name="fehler_details" DockPanel.Dock="Left" Content="Details" Cursor="Hand" VerticalAlignment="Center">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource Violett}" Padding="2,6"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
          </DockPanel>
          <Grid>
            <StackPanel x:Name="fehler_inhalt">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource RotHell}" VerticalAlignment="Center">
                  <TextBlock Text="!" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Rot}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Style="{StaticResource Titel}" Text="Das hat nicht ganz geklappt" Margin="16,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="fehler_satz" Style="{StaticResource Satz}" Foreground="{StaticResource Text}" FontSize="15"/>
              <Border Style="{StaticResource KarteRahmen}" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource Satz}" Text="Was genau passiert ist, steht im Protokoll. Schick es mit, wenn du um Hilfe bittest:"/>
                  <TextBox x:Name="fehler_pfad" Margin="0,6,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="fehler_kopiert" Margin="2,10,0,0" Foreground="{StaticResource Neben}" FontSize="12.5"/>
            </StackPanel>
            <TextBox x:Name="fehler_protokoll" Style="{StaticResource Protokoll}" Visibility="Collapsed" Margin="0,0,0,12"/>
          </Grid>
        </DockPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
