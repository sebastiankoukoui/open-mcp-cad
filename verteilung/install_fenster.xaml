<!--
Open MCP CAD - das Einrichtungsfenster (seit 2026-10-09, Rueckmeldung: das
schwarze Fenster des Installers schreckte ab). Geladen von
install_fenster.ps1 (WPF, Windows PowerShell 5.1). Jede Seite ist ein
DockPanel "Seite_<name>", gezeigt wird immer genau eine.

Seit 2026-10-10 in vier Sprachen: hier stehen KEINE sichtbaren Texte mehr,
nur Schluessel ({DynamicResource t_...}). Die Texte stehen je Sprache in
install_fenster_texte.xml (UTF-8, Deutsch verbindlich); install_fenster.ps1
setzt sie als Ressourcen der Wurzel, bevor etwas gezeigt wird. Den Titel
des Fensters setzt das Skript selbst (das Fenster liegt ausserhalb der
Wurzel). Fest bleiben nur Zeichen ("i", "!", die Ziffern) und der Name
"Open MCP CAD".

Farben aus dem Logo: Violett #5B3CC4, hell #EEEAFB. Schrift Segoe UI.
Keine Emoji, keine Pfade ausser in "Details" und auf der Fehlerseite.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource t_fenster_titel}"
        SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F7F6FB">
  <!-- Alles haengt an "Wurzel" (auch Schrift und Ressourcen): so laesst sie
       sich ohne Fenster rendern (install_fenster.ps1 -Rendern). -->
  <Border x:Name="Wurzel" Width="640" Height="480" Background="#F7F6FB"
          TextElement.FontFamily="Segoe UI" TextElement.FontSize="14"
          UseLayoutRounding="True" SnapsToDevicePixels="True"
          TextOptions.TextFormattingMode="Ideal">
  <Border.Resources>
    <SolidColorBrush x:Key="Violett" Color="#5B3CC4"/>
    <SolidColorBrush x:Key="ViolettDunkel" Color="#4A2FA6"/>
    <SolidColorBrush x:Key="ViolettHell" Color="#EEEAFB"/>
    <SolidColorBrush x:Key="Text" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Neben" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Rahmen" Color="#E4E1EE"/>
    <SolidColorBrush x:Key="Karte" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Orange" Color="#C26A00"/>
    <SolidColorBrush x:Key="OrangeHell" Color="#FFF5E6"/>
    <SolidColorBrush x:Key="Rot" Color="#D2302C"/>
    <SolidColorBrush x:Key="RotHell" Color="#FDEEEE"/>


    <!-- Hauptknopf: violett, gefuellt. -->
    <Style x:Key="Haupt" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Violett}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="132"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource ViolettDunkel}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource ViolettDunkel}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#CFC6F0"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Zweitknopf: weiss mit Rahmen. -->
    <Style x:Key="Zweit" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="110"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="#D6D2E3" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F2F0F8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#B0B0B5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Verweis: nur Text, violett. -->
    <Style x:Key="Verweis" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Violett}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="2,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Ein Knopf nur mit Symbol (seit 2026-10-10): rund, beim Zeigen hinterlegt. -->
    <Style x:Key="SymbolKnopf" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#DCD3F7"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="#DCD3F7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Symbol einer App bzw. eines Programms (seit 2026-10-10): das echte,
         wenn es auf dem PC zu lesen ist (Tag = Bild, install_fenster.ps1
         Logos-Setzen), sonst ein Strich-Symbol (Lucide message-square bzw.
         terminal). Fremde Logos liegen NIE im Paket. -->
    <Style x:Key="LogoApp" TargetType="ContentControl">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid>
              <Border x:Name="ersatz" Background="{StaticResource ViolettHell}" CornerRadius="8" Visibility="Collapsed">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" Stroke="{StaticResource Violett}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Canvas>
                </Viewbox>
              </Border>
              <Image x:Name="bild" Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="ersatz" Property="Visibility" Value="Visible"/>
                <Setter TargetName="bild" Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LogoCli" TargetType="ContentControl" BasedOn="{StaticResource LogoApp}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid>
              <Border x:Name="ersatz" Background="{StaticResource ViolettHell}" CornerRadius="8" Visibility="Collapsed">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="M4 17 10 11 4 5M12 19h8" Stroke="{StaticResource Violett}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Canvas>
                </Viewbox>
              </Border>
              <Image x:Name="bild" Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="ersatz" Property="Visibility" Value="Visible"/>
                <Setter TargetName="bild" Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Der Kreisel waehrend "Nochmal suchen" (dreht sich per Animation). -->
    <Style x:Key="Kreisel" TargetType="Ellipse">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Stroke" Value="{StaticResource Violett}"/>
      <Setter Property="StrokeThickness" Value="2"/>
      <Setter Property="StrokeDashArray" Value="5 4"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Ankreuzen: grosses, rundes Kaestchen. -->
    <Style x:Key="Haken" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="k" Width="22" Height="22" CornerRadius="6" BorderThickness="1.5" BorderBrush="#BDB6D6" Background="White" VerticalAlignment="Center">
                <Path x:Name="h" Data="M 5,11 L 9,15 L 17,7" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="k" Property="Background" Value="{StaticResource Violett}"/>
                <Setter TargetName="k" Property="BorderBrush" Value="{StaticResource Violett}"/>
                <Setter TargetName="h" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="k" Property="Background" Value="#F0EFF4"/>
                <Setter TargetName="k" Property="BorderBrush" Value="#DAD7E4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Wahl" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="r" Background="White" BorderBrush="{StaticResource Rahmen}" BorderThickness="1.5" CornerRadius="10" Padding="16,12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="o" Width="20" Height="20" Stroke="#BDB6D6" StrokeThickness="1.5" Fill="White" VerticalAlignment="Center"/>
                <Ellipse x:Name="i" Width="10" Height="10" Fill="White" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="r" Property="BorderBrush" Value="{StaticResource Violett}"/>
                <Setter TargetName="o" Property="Fill" Value="{StaticResource Violett}"/>
                <Setter TargetName="o" Property="Stroke" Value="{StaticResource Violett}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Eine Karte wie "Wahl", aber zum Ankreuzen (seit 2026-10-10: mehrere
         Cadwork-Versionen auf einem PC, Seite "Welches Cadwork?"). -->
    <Style x:Key="WahlHaken" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="r" Background="White" BorderBrush="{StaticResource Rahmen}" BorderThickness="1.5" CornerRadius="10" Padding="16,12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="k" Width="22" Height="22" CornerRadius="6" BorderThickness="1.5" BorderBrush="#BDB6D6" Background="White" VerticalAlignment="Center">
                  <Path x:Name="h" Data="M 5,11 L 9,15 L 17,7" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="r" Property="BorderBrush" Value="{StaticResource Violett}"/>
                <Setter TargetName="k" Property="Background" Value="{StaticResource Violett}"/>
                <Setter TargetName="k" Property="BorderBrush" Value="{StaticResource Violett}"/>
                <Setter TargetName="h" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Titel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Satz" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Neben}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style x:Key="KarteRahmen" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Karte}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rahmen}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18,14"/>
    </Style>
    <Style x:Key="Marke" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource ViolettHell}"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Leiste" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4" Background="#E7E3F4"/>
              <Border x:Name="PART_Indicator" CornerRadius="4" Background="{StaticResource Violett}" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Ein Schritt im Fortschritt: Kreis (offen / laeuft / fertig / fehler) und Text. -->
    <Style x:Key="SchrittText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Neben}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="14,0,0,0"/>
    </Style>
    <Style x:Key="Protokoll" TargetType="TextBox">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Background" Value="#FBFBFD"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rahmen}"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
  </Border.Resources>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Kopf -->
      <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Rahmen}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
          <Image x:Name="KopfLogo" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Open MCP CAD" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
          <TextBlock Text="{DynamicResource t_einrichtung}" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Neben}"/>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1" Margin="40,26,40,26">

        <!-- 1 Willkommen -->
        <DockPanel x:Name="Seite_willkommen">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="willkommen_weiter" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_los_gehts}" IsEnabled="False"/>
            <TextBlock x:Name="willkommen_stand" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource Neben}" FontSize="13"/>
          </DockPanel>
          <StackPanel VerticalAlignment="Center" Margin="0,0,0,10">
            <Border Width="60" Height="60" CornerRadius="14" Background="White" BorderBrush="{StaticResource Rahmen}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12">
              <Image x:Name="willkommen_logo" Width="50" Height="50" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Style="{StaticResource Titel}" Text="{DynamicResource t_willkommen_bei_open_mcp}"/>
            <TextBlock Style="{StaticResource Satz}" FontSize="15" Text="{DynamicResource t_damit_zeichnet_eine_ki}"/>
            <Border x:Name="willkommen_hinweis" Style="{StaticResource KarteRahmen}" Margin="0,16,0,0">
              <StackPanel Orientation="Horizontal">
                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource ViolettHell}" VerticalAlignment="Top">
                  <TextBlock Text="i" FontWeight="Bold" Foreground="{StaticResource Violett}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Margin="12,3,0,0" TextWrapping="Wrap" Width="470" Foreground="{StaticResource Text}" Text="{DynamicResource t_schliesse_cadwork_bevor_du}"/>
              </StackPanel>
            </Border>
            <Border x:Name="willkommen_ki_hilfe" Style="{StaticResource KarteRahmen}" Margin="0,10,0,0" Background="{StaticResource ViolettHell}" BorderThickness="0">
              <DockPanel>
                <!-- Seit 2026-10-10 (Rueckmeldung: man meinte, den Satz selbst
                     kopieren zu muessen): "diesen Text" ist ein Verweis, rechts
                     das Kopier-Symbol (Lucide copy/check, Strich wie im Dock).
                     Beide kopieren den Text fuer die KI-App. -->
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="64">
                  <Button x:Name="willkommen_kopieren" Style="{StaticResource SymbolKnopf}" HorizontalAlignment="Center" ToolTip="{DynamicResource t_text_kopieren}" AutomationProperties.Name="{DynamicResource t_text_kopieren}">
                    <Grid Width="20" Height="20">
                      <Viewbox x:Name="willkommen_symbol_kopieren">
                        <Canvas Width="24" Height="24">
                          <Rectangle Canvas.Left="8" Canvas.Top="8" Width="14" Height="14" RadiusX="2" RadiusY="2" Stroke="{StaticResource Violett}" StrokeThickness="2"/>
                          <Path Data="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" Stroke="{StaticResource Violett}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                      </Viewbox>
                      <Viewbox x:Name="willkommen_symbol_haken" Visibility="Collapsed">
                        <Canvas Width="24" Height="24">
                          <Path Data="M20 6 9 17l-5-5" Stroke="{StaticResource Violett}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                      </Viewbox>
                    </Grid>
                  </Button>
                  <TextBlock x:Name="willkommen_kopiert" FontSize="12" Foreground="{StaticResource Violett}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock x:Name="willkommen_ki_satz" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Text}" VerticalAlignment="Center"><Run Text="{DynamicResource t_ki_hilfe_vor}"/><Hyperlink x:Name="willkommen_link" Foreground="{StaticResource Violett}" Cursor="Hand" AutomationProperties.Name="{DynamicResource t_text_kopieren}"><Run Text="{DynamicResource t_ki_hilfe_link}"/></Hyperlink><Run Text="{DynamicResource t_ki_hilfe_nach}"/></TextBlock>
              </DockPanel>
            </Border>
          </StackPanel>
        </DockPanel>

        <!-- 1b Wo arbeiten? (seit 2026-10-09) -->
        <DockPanel x:Name="Seite_wo" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="wo_weiter" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_weiter}"/>
            <Button x:Name="wo_zurueck" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="{DynamicResource t_zurueck}" Margin="0,0,10,0"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="{DynamicResource t_wo_moechtest_du_mit}"/>
            <TextBlock Style="{StaticResource Satz}" Margin="0,0,0,14" Text="{DynamicResource t_du_kannst_spaeter_jederzeit}"/>
            <RadioButton x:Name="wo_app" Style="{StaticResource Wahl}" GroupName="wo">
              <StackPanel>
                <TextBlock Text="{DynamicResource t_in_deiner_ki_app}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" TextWrapping="Wrap" Text="{DynamicResource t_claude_desktop_oder_die}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="wo_chat" Style="{StaticResource Wahl}" GroupName="wo">
              <StackPanel>
                <TextBlock Text="{DynamicResource t_direkt_in_cadwork_im}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" TextWrapping="Wrap" Text="{DynamicResource t_der_chat_steht_neben}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="wo_beides" Style="{StaticResource Wahl}" GroupName="wo">
              <StackPanel>
                <TextBlock Text="{DynamicResource t_beides}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" TextWrapping="Wrap" Text="{DynamicResource t_die_app_fuer_den}"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </DockPanel>

        <!-- 2c Welche KI im Chat in Cadwork? (seit 2026-10-09). Seit 2026-10-10
             (Rueckmeldung): jede Wahl immer waehlbar, die Plakette sagt
             "Gefunden" oder "Wird mitinstalliert". -->
        <DockPanel x:Name="Seite_chat_ki" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="chat_weiter" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_weiter}"/>
            <Button x:Name="chat_zurueck" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="{DynamicResource t_zurueck}" Margin="0,0,10,0"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="{DynamicResource t_welche_ki_im_chat}"/>
            <TextBlock Style="{StaticResource Satz}" Margin="0,0,0,14" Text="{DynamicResource t_der_chat_braucht_ein}"/>
            <RadioButton x:Name="chat_claude" Style="{StaticResource Wahl}" GroupName="chat">
              <DockPanel>
                <Border x:Name="chat_marke_claude" DockPanel.Dock="Right" Style="{StaticResource Marke}">
                  <TextBlock x:Name="chat_stand_claude" FontSize="12.5" Foreground="{StaticResource Violett}" FontWeight="SemiBold"/>
                </Border>
                <ContentControl x:Name="chat_logo_claude" DockPanel.Dock="Left" Style="{StaticResource LogoCli}"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource t_chat_name_claude}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                  <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" Text="{DynamicResource t_mit_einem_claude_abo}"/>
                </StackPanel>
              </DockPanel>
            </RadioButton>
            <RadioButton x:Name="chat_codex" Style="{StaticResource Wahl}" GroupName="chat">
              <DockPanel>
                <Border x:Name="chat_marke_codex" DockPanel.Dock="Right" Style="{StaticResource Marke}">
                  <TextBlock x:Name="chat_stand_codex" FontSize="12.5" Foreground="{StaticResource Violett}" FontWeight="SemiBold"/>
                </Border>
                <ContentControl x:Name="chat_logo_codex" DockPanel.Dock="Left" Style="{StaticResource LogoCli}"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource t_chat_name_codex}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                  <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" Text="{DynamicResource t_mit_einem_chatgpt_abo}"/>
                </StackPanel>
              </DockPanel>
            </RadioButton>
            <RadioButton x:Name="chat_spaeter" Style="{StaticResource Wahl}" GroupName="chat">
              <StackPanel>
                <TextBlock Text="{DynamicResource t_spaeter_oder_mit_eigenem}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" TextWrapping="Wrap" Text="{DynamicResource t_im_chat_unter_einstellungen}"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </DockPanel>

        <!-- 2 Deine KI-App. Seit 2026-10-10 (Rueckmeldung): jede App immer zu
             sehen, gefunden mit Plakette, sonst "Holen"; das echte Symbol der
             App, wenn sie da ist (Logos-Setzen), sonst ein Strich-Symbol;
             "Nochmal suchen" zeigt, dass es sucht, und was es fand. -->
        <DockPanel x:Name="Seite_ki" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="ki_weiter" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_weiter}"/>
            <Button x:Name="ki_zurueck" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="{DynamicResource t_zurueck}" Margin="0,0,10,0"/>
            <Button x:Name="ki_nochmal" DockPanel.Dock="Left" Style="{StaticResource Verweis}" Content="{DynamicResource t_nochmal_suchen}" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="{DynamicResource t_deine_ki_app}"/>
            <TextBlock Style="{StaticResource Satz}" Text="{DynamicResource t_in_welcher_app_moechtest}"/>
            <StackPanel Margin="0,12,0,0">
              <Border x:Name="ki_karte_claude_desktop" Style="{StaticResource KarteRahmen}" Padding="16,9" Margin="0,0,0,8">
                <DockPanel>
                  <Button x:Name="ki_holen_claude_desktop" DockPanel.Dock="Right" Style="{StaticResource Verweis}" Content="{DynamicResource t_herunterladen}" VerticalAlignment="Center"/>
                  <Border x:Name="ki_marke_claude_desktop" DockPanel.Dock="Right" Style="{StaticResource Marke}">
                    <TextBlock x:Name="ki_stand_claude_desktop" FontSize="12.5" Foreground="{StaticResource Violett}" FontWeight="SemiBold"/>
                  </Border>
                  <CheckBox x:Name="ki_claude_desktop" Style="{StaticResource Haken}">
                    <DockPanel>
                      <ContentControl x:Name="ki_logo_claude_desktop" DockPanel.Dock="Left" Style="{StaticResource LogoApp}"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource t_name_claude_desktop}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" Text="{DynamicResource t_fuer_ein_claude_abo}"/>
                      </StackPanel>
                    </DockPanel>
                  </CheckBox>
                </DockPanel>
              </Border>
              <Border x:Name="ki_karte_codex" Style="{StaticResource KarteRahmen}" Padding="16,9" Margin="0,0,0,8">
                <DockPanel>
                  <Button x:Name="ki_holen_codex" DockPanel.Dock="Right" Style="{StaticResource Verweis}" Content="{DynamicResource t_herunterladen}" VerticalAlignment="Center"/>
                  <Border x:Name="ki_marke_codex" DockPanel.Dock="Right" Style="{StaticResource Marke}">
                    <TextBlock x:Name="ki_stand_codex" FontSize="12.5" Foreground="{StaticResource Violett}" FontWeight="SemiBold"/>
                  </Border>
                  <CheckBox x:Name="ki_codex" Style="{StaticResource Haken}">
                    <DockPanel>
                      <ContentControl x:Name="ki_logo_codex" DockPanel.Dock="Left" Style="{StaticResource LogoApp}"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource t_chatgpt_app_mit_codex}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" Text="{DynamicResource t_fuer_ein_chatgpt_abo_desktop}"/>
                      </StackPanel>
                    </DockPanel>
                  </CheckBox>
                </DockPanel>
              </Border>
              <Border x:Name="ki_karte_claude_code" Style="{StaticResource KarteRahmen}" Padding="16,9" Margin="0,0,0,8">
                <DockPanel>
                  <Button x:Name="ki_holen_claude_code" DockPanel.Dock="Right" Style="{StaticResource Verweis}" Content="{DynamicResource t_herunterladen}" VerticalAlignment="Center"/>
                  <Border x:Name="ki_marke_claude_code" DockPanel.Dock="Right" Style="{StaticResource Marke}">
                    <TextBlock x:Name="ki_stand_claude_code" FontSize="12.5" Foreground="{StaticResource Violett}" FontWeight="SemiBold"/>
                  </Border>
                  <CheckBox x:Name="ki_claude_code" Style="{StaticResource Haken}">
                    <DockPanel>
                      <ContentControl x:Name="ki_logo_claude_code" DockPanel.Dock="Left" Style="{StaticResource LogoCli}"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource t_name_claude_code}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock FontSize="12.5" Foreground="{StaticResource Neben}" Text="{DynamicResource t_claude_im_befehlsfenster}"/>
                      </StackPanel>
                    </DockPanel>
                  </CheckBox>
                </DockPanel>
              </Border>
            </StackPanel>
            <TextBlock x:Name="ki_chatgpt" Style="{StaticResource Satz}" FontSize="12.5" Margin="2,2,0,0" Text="{DynamicResource t_es_geht_nur_mit}"/>
            <StackPanel x:Name="ki_suche" Orientation="Horizontal" Margin="2,6,0,0" Visibility="Hidden">
              <Ellipse x:Name="ki_kreisel" Style="{StaticResource Kreisel}"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
              <TextBlock x:Name="ki_suche_text" FontSize="12.5" Foreground="{StaticResource Violett}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>

        <!-- 2b Keine KI-App gefunden -->
        <DockPanel x:Name="Seite_ki_keine" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="keine_nochmal" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_nochmal_suchen}"/>
            <Button x:Name="keine_zurueck" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="{DynamicResource t_zurueck}" Margin="0,0,10,0"/>
            <Button x:Name="keine_ohne" DockPanel.Dock="Left" Style="{StaticResource Verweis}" Content="{DynamicResource t_ohne_ki_app_weiter}" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="{DynamicResource t_du_brauchst_zuerst_eine}"/>
            <TextBlock Style="{StaticResource Satz}" Text="{DynamicResource t_open_mcp_cad_verbindet}"/>
            <UniformGrid Columns="2" Margin="0,16,0,0">
              <Button x:Name="keine_claude" Margin="0,0,8,0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Style="{StaticResource KarteRahmen}" Padding="16,14">
                      <DockPanel>
                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource LogoApp}" Tag="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource t_claude_desktop_holen}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Violett}" TextWrapping="Wrap"/>
                          <TextBlock Text="{DynamicResource t_fuer_ein_claude_abo}" Foreground="{StaticResource Neben}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Violett}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button x:Name="keine_codex" Margin="8,0,0,0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Style="{StaticResource KarteRahmen}" Padding="16,14">
                      <DockPanel>
                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource LogoApp}" Tag="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource t_chatgpt_app_holen}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Violett}" TextWrapping="Wrap"/>
                          <TextBlock Text="{DynamicResource t_fuer_ein_chatgpt_abo}" Foreground="{StaticResource Neben}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Violett}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </UniformGrid>
            <Border Style="{StaticResource KarteRahmen}" Margin="0,12,0,0" Background="{StaticResource ViolettHell}" BorderThickness="0" Padding="18,10">
              <TextBlock x:Name="keine_chatgpt" TextWrapping="Wrap" Foreground="{StaticResource Text}" Text="{DynamicResource t_es_geht_nur_mit}"/>
            </Border>
            <Button x:Name="keine_claude_code" Style="{StaticResource Verweis}" Content="{DynamicResource t_claude_code_holen}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            <StackPanel x:Name="keine_suche" Orientation="Horizontal" Margin="2,2,0,0" Visibility="Hidden">
              <Ellipse x:Name="keine_kreisel" Style="{StaticResource Kreisel}"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
              <TextBlock x:Name="keine_suche_text" FontSize="12.5" Foreground="{StaticResource Violett}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>

        <!-- 3a Welches Cadwork? (nur bei mehreren Profilen; seit 2026-10-10 je
             Profil ein Haken, profil_wahl_<i>, gebaut in Profil-Fuellen) -->
        <DockPanel x:Name="Seite_profil" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="profil_weiter" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_weiter}"/>
            <Button x:Name="profil_zurueck" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="{DynamicResource t_zurueck}" Margin="0,0,10,0"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="{DynamicResource t_welches_cadwork}"/>
            <TextBlock Style="{StaticResource Satz}" Text="{DynamicResource t_auf_diesem_pc_gibt}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230" Margin="0,16,0,0">
              <StackPanel x:Name="profil_liste"/>
            </ScrollViewer>
          </StackPanel>
        </DockPanel>

        <!-- 3b Cadwork-Version passt nicht -->
        <DockPanel x:Name="Seite_version" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="version_schliessen" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_schliessen}"/>
            <Button x:Name="version_zurueck" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="{DynamicResource t_zurueck}" Margin="0,0,10,0"/>
            <Button x:Name="version_trotzdem" DockPanel.Dock="Left" Style="{StaticResource Verweis}" Content="{DynamicResource t_trotzdem_installieren}" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel>
            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource OrangeHell}" HorizontalAlignment="Left" Margin="0,0,0,16">
              <TextBlock Text="!" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Orange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource Titel}" Text="{DynamicResource t_das_passt_nicht_zu}"/>
            <TextBlock x:Name="version_text" Style="{StaticResource Satz}" Foreground="{StaticResource Text}"/>
            <TextBlock Style="{StaticResource Satz}" Margin="0,10,0,0" Text="{DynamicResource t_dort_startet_open_mcp}"/>
          </StackPanel>
        </DockPanel>

        <!-- 3c Python fehlt -->
        <DockPanel x:Name="Seite_python" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="python_ja" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_mitinstallieren}"/>
            <Button x:Name="python_zurueck" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="{DynamicResource t_zurueck}" Margin="0,0,10,0"/>
            <Button x:Name="python_nein" DockPanel.Dock="Left" Style="{StaticResource Verweis}" Content="{DynamicResource t_abbrechen}" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="{DynamicResource t_ein_programmteil_fehlt_noch}"/>
            <TextBlock Style="{StaticResource Satz}" Text="{DynamicResource t_open_mcp_cad_braucht}"/>
            <Border Style="{StaticResource KarteRahmen}" Margin="0,18,0,0">
              <TextBlock x:Name="python_weg" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
            </Border>
          </StackPanel>
        </DockPanel>

        <!-- 4 Bereit -->
        <DockPanel x:Name="Seite_bereit" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="bereit_installieren" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_installieren}"/>
            <Button x:Name="bereit_zurueck" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="{DynamicResource t_zurueck}" Margin="0,0,10,0"/>
          </DockPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Titel}" Text="{DynamicResource t_bereit_zum_installieren}"/>
            <TextBlock Style="{StaticResource Satz}" Text="{DynamicResource t_das_richte_ich_jetzt}"/>
            <Border Style="{StaticResource KarteRahmen}" Margin="0,16,0,0">
              <StackPanel x:Name="bereit_liste"/>
            </Border>
            <!-- Seit 2026-10-10 (Rueckmeldung: auf einem Laptop lag noch das alte
                 Plugin "LignoAI Connect", zwei Eintraege im Cadwork-Menue):
                 nur zu sehen, wenn install.ps1 (Alte-Plugins) eines findet. -->
            <Border x:Name="bereit_alt" Style="{StaticResource KarteRahmen}" Margin="0,12,0,0" Background="{StaticResource OrangeHell}" BorderThickness="0" Visibility="Collapsed">
              <CheckBox x:Name="bereit_alt_haken" Style="{StaticResource Haken}" IsChecked="True">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Text}" Text="{DynamicResource t_bereit_alt}"/>
                  <TextBlock x:Name="bereit_alt_name" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource Neben}" TextWrapping="Wrap"/>
                </StackPanel>
              </CheckBox>
            </Border>
            <TextBlock Style="{StaticResource Satz}" Margin="0,14,0,0" FontSize="12.5" Text="{DynamicResource t_vorher_sichere_ich_die}"/>
          </StackPanel>
        </DockPanel>

        <!-- 5 Es laeuft -->
        <DockPanel x:Name="Seite_laeuft" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <ToggleButton x:Name="laeuft_details" DockPanel.Dock="Left" Content="{DynamicResource t_details_anzeigen}" Cursor="Hand" VerticalAlignment="Center">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource Violett}" Padding="2,6"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Neben}" FontSize="12.5" Text="{DynamicResource t_das_dauert_ein_paar}"/>
          </DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Titel}" Text="{DynamicResource t_wird_eingerichtet}"/>
            <ProgressBar x:Name="laeuft_leiste" Style="{StaticResource Leiste}" Minimum="0" Maximum="100" Value="0" Margin="0,6,0,4"/>
            <!-- Bewegtes Band: es arbeitet, auch wenn eine Zeile lange gleich bleibt. -->
            <Border x:Name="laeuft_band" Height="3" CornerRadius="1.5" Background="#E7E3F4" ClipToBounds="True" Visibility="Hidden">
              <Rectangle x:Name="laeuft_band_lauf" Width="140" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#005B3CC4" Offset="0"/>
                    <GradientStop Color="#FF5B3CC4" Offset="0.5"/>
                    <GradientStop Color="#005B3CC4" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                  <TranslateTransform x:Name="laeuft_band_weg" X="180"/>
                </Rectangle.RenderTransform>
              </Rectangle>
            </Border>
            <TextBlock x:Name="laeuft_unterzeile" FontSize="12.5" Foreground="{StaticResource Neben}" Margin="0,6,0,12" TextTrimming="CharacterEllipsis" Text=" "/>
          </StackPanel>
          <Grid>
            <StackPanel x:Name="laeuft_schritte">
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s1_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s1_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s1_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="{DynamicResource t_cadwork_pruefen}"/>
              </Grid>
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s2_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s2_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s2_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="{DynamicResource t_open_mcp_cad_in}"/>
              </Grid>
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s3_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s3_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s3_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="{DynamicResource t_verbindung_fuer_die_ki}"/>
              </Grid>
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s4_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s4_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s4_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="{DynamicResource t_einstellungen_speichern}"/>
              </Grid>
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s5_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s5_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s5_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="{DynamicResource t_ki_app_verbinden}"/>
              </Grid>
              <Grid x:Name="s6_zeile" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="s6_kreis" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#D6D2E3" Background="White">
                  <Path x:Name="s6_haken" Data="M 6.5,12 L 10.5,16 L 17.5,8.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="s6_text" Grid.Column="1" Style="{StaticResource SchrittText}" Text="{DynamicResource t_ki_fuer_den_chat}"/>
              </Grid>
            </StackPanel>
            <TextBox x:Name="laeuft_protokoll" Style="{StaticResource Protokoll}" Visibility="Collapsed" Margin="0,0,0,12"/>
          </Grid>
        </DockPanel>

        <!-- 5b Anmelden (seit 2026-10-09) -->
        <DockPanel x:Name="Seite_anmelden" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="anmelden_los" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_anmelden}"/>
            <Button x:Name="anmelden_spaeter" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="{DynamicResource t_spaeter}" Margin="0,0,10,0"/>
          </DockPanel>
          <StackPanel>
            <TextBlock x:Name="anmelden_titel" Style="{StaticResource Titel}" Text="{DynamicResource t_bei_claude_anmelden}"/>
            <TextBlock Style="{StaticResource Satz}" Text="{DynamicResource t_damit_der_chat_in}"/>
            <Border x:Name="anmelden_karte" Style="{StaticResource KarteRahmen}" Margin="0,16,0,0">
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text}" LineHeight="21" Text="{DynamicResource t_nach_anmelden_oeffnet_sich}"/>
            </Border>
            <TextBlock x:Name="anmelden_stand" Style="{StaticResource Satz}" Margin="2,12,0,0"/>
          </StackPanel>
        </DockPanel>

        <!-- 6 Fertig -->
        <DockPanel x:Name="Seite_fertig" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="fertig_schliessen" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_schliessen}"/>
            <Button x:Name="fertig_anleitung" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="{DynamicResource t_anleitung_oeffnen}" Margin="0,0,10,0"/>
            <ToggleButton x:Name="fertig_details" DockPanel.Dock="Left" Content="{DynamicResource t_details_anzeigen}" Cursor="Hand" VerticalAlignment="Center">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource Violett}" Padding="2,6"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
          </DockPanel>
          <Grid>
            <StackPanel x:Name="fertig_inhalt">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Violett}" VerticalAlignment="Center">
                  <Path Data="M 12,22 L 19,29 L 32,15" Stroke="White" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
                <TextBlock x:Name="fertig_titel" Style="{StaticResource Titel}" Text="{DynamicResource t_fertig_eingerichtet}" Margin="16,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="fertig_ki" Style="{StaticResource Satz}" Margin="0,4,0,14"/>
              <Border x:Name="fertig_schritte" Style="{StaticResource KarteRahmen}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource t_so_geht_es_weiter}" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,8"/>
                  <Grid x:Name="fertig_schritt1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ViolettHell}" VerticalAlignment="Top"><TextBlock Text="1" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Violett}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock x:Name="fertig_text1" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Text}" Text="{DynamicResource t_fertig_app_1}"/>
                  </Grid>
                  <Grid x:Name="fertig_schritt2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ViolettHell}" VerticalAlignment="Top"><TextBlock Text="2" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Violett}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock x:Name="fertig_text2" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Text}" Text="{DynamicResource t_fertig_app_2}"/>
                  </Grid>
                  <Grid x:Name="fertig_schritt3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ViolettHell}" VerticalAlignment="Top"><TextBlock Text="3" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Violett}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock x:Name="fertig_text3" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Text}" Text="{DynamicResource t_fertig_app_3}"/>
                  </Grid>
                  <Grid x:Name="fertig_schritt4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ViolettHell}" VerticalAlignment="Top"><TextBlock Text="4" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Violett}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock x:Name="fertig_text4" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                  </Grid>
                </StackPanel>
              </Border>
              <!-- Seit 2026-10-10: wer nur die KI-App gewaehlt hat, kann den
                   Chat in Cadwork hier dazunehmen. -->
              <Button x:Name="fertig_chat_dazu" Style="{StaticResource Verweis}" Content="{DynamicResource t_chat_auch}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <TextBox x:Name="fertig_protokoll" Style="{StaticResource Protokoll}" Visibility="Collapsed" Margin="0,0,0,12"/>
          </Grid>
        </DockPanel>

        <!-- 7 Fehler -->
        <DockPanel x:Name="Seite_fehler" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button x:Name="fehler_schliessen" DockPanel.Dock="Right" Style="{StaticResource Haupt}" Content="{DynamicResource t_schliessen}"/>
            <Button x:Name="fehler_kopieren" DockPanel.Dock="Right" Style="{StaticResource Zweit}" Content="{DynamicResource t_details_kopieren}" Margin="0,0,10,0"/>
            <ToggleButton x:Name="fehler_details" DockPanel.Dock="Left" Content="{DynamicResource t_details_anzeigen}" Cursor="Hand" VerticalAlignment="Center">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource Violett}" Padding="2,6"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
          </DockPanel>
          <Grid>
            <StackPanel x:Name="fehler_inhalt">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource RotHell}" VerticalAlignment="Center">
                  <TextBlock Text="!" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Rot}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Style="{StaticResource Titel}" Text="{DynamicResource t_das_hat_nicht_ganz}" Margin="16,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="fehler_satz" Style="{StaticResource Satz}" Foreground="{StaticResource Text}" FontSize="15"/>
              <Border Style="{StaticResource KarteRahmen}" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource Satz}" Text="{DynamicResource t_was_genau_passiert_ist}"/>
                  <TextBox x:Name="fehler_pfad" Margin="0,6,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="fehler_kopiert" Margin="2,10,0,0" Foreground="{StaticResource Neben}" FontSize="12.5"/>
            </StackPanel>
            <TextBox x:Name="fehler_protokoll" Style="{StaticResource Protokoll}" Visibility="Collapsed" Margin="0,0,0,12"/>
          </Grid>
        </DockPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
